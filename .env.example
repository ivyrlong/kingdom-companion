# -----------------------------------------------------------------------------
# Local dev — copy to .env and fill in.
# -----------------------------------------------------------------------------

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kingdom_companion"

# NextAuth - generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Kingdom Companion"

# -----------------------------------------------------------------------------
# Production (VPS /opt/kingdom-companion/.env) — docker-compose reads these.
# Do not commit real values. See docs/deploy.md for setup.
# -----------------------------------------------------------------------------

# Postgres container credentials (owned by the compose stack; the app talks
# to it over the compose network so DATABASE_URL above is not needed in prod
# — docker-compose.yml builds DATABASE_URL from these three).
POSTGRES_USER=kc
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=kingdom_companion

# Host port bindings (loopback-scoped; Caddy on the host is the only client).
APP_BIND=127.0.0.1:8804
DB_BIND=127.0.0.1:35432

# Public URL — must match the Caddy site block and DNS record.
# AUTH_URL is also used by NextAuth to build callback URLs + cookies.
# AUTH_SECRET: openssl rand -base64 32
# AUTH_URL=https://kc.blmfamily.com
