generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models (NextAuth) ────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           Role      @default(USER)
  ageGroup       AgeGroup  @default(YOUTH)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  profile      Profile?
  gameSessions GameSession[]
  scores       Score[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ────────────────────────────────────────────────

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  avatarId     String   @default("default")
  xp           Int      @default(0)
  level        Int      @default(1)
  congregation String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges Badge[]
}

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  ageGroup    AgeGroup
  category    String
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gameSessions GameSession[]
  scores       Score[]
}

model GameSession {
  id          String        @id @default(cuid())
  userId      String
  gameId      String
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  status      SessionStatus @default(IN_PROGRESS)
  score       Int           @default(0)
  data        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameId])
}

model Score {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  value     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, value(sort: Desc)])
  @@index([userId, gameId])
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  imageUrl    String?

  profiles Profile[]
}

// ─── Enums ─────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AgeGroup {
  LITTLE_ONES
  YOUTH
  ADULT
  FAMILY
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
