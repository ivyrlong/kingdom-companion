generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models (NextAuth) ────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           Role      @default(USER)
  ageGroup       AgeGroup  @default(YOUTH)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  profile                 Profile?
  gameSessions            GameSession[]
  scores                  Score[]
  encyclopediaCollections UserEncyclopediaCollection[]
  personalEntries         PersonalEntry[]
  dailyResponses          DailyResponse[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ────────────────────────────────────────────────

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String
  avatarId     String   @default("default")
  xp           Int      @default(0)
  level        Int      @default(1)
  congregation String?
  // Encyclopedia preferences. Mode applies to Youth/Family (Little Ones is
  // always playful, Adult always notebook). receiveCuratedFindings is the
  // Adult opt-in for admin-curated discoveries (off by default).
  encyclopediaMode       EncyclopediaMode @default(PLAYFUL)
  receiveCuratedFindings Boolean          @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges Badge[]
}

// Game = a game ENGINE (e.g. "Word Search", "Trivia"). The mechanic, not the content.
model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  ageGroup    AgeGroup
  category    String
  imageUrl    String?
  // Per-audience card art. Keys: "SHARED" | "LITTLE_ONES" | "YOUTH" | "ADULT" | "FAMILY"
  // -> image path (e.g. "/uploads/abc.png"). Resolved by viewer age group with
  // fallback to SHARED. Empty object means no custom art (UI shows a placeholder).
  cardImages  Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances    GameInstance[]
  gameSessions GameSession[]
  scores       Score[]
}

// MeetingWeek groups content for a specific week's meetings.
model MeetingWeek {
  id        String   @id @default(cuid())
  weekOf    DateTime @unique // Monday of the target week
  title     String   // e.g. "Week of April 6, 2026"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentPacks ContentPack[]
}

// ContentPack = extracted material from an article, daily text, or evergreen Bible topic.
model ContentPack {
  id            String          @id @default(cuid())
  title         String          // e.g. "WT Study - April 6" or "Daily Text - March 30"
  source        ContentSource
  context       GameContext      @default(EVERGREEN)
  sourceText    String?         // original pasted text (for reference)
  comment          String?      // Daily Text: the normal comment (Youth/Adult)
  simplifiedComment String?     // Daily Text: simplified lesson for Little Ones
  featuredGameSlug String?      // Daily Text: game embedded on the Little Ones Today page
  date          DateTime?       // target date (for daily text) or null
  vocabulary    Json            // string[]
  scriptures    Json            // { reference: string, text: string }[]
  keyPeople     Json            // string[]
  themes        Json            // string[]
  questions     Json            // { question, answer, simplifiedAnswer?, keyWords?, options?, imageUrl?, subheading?, references? }[]
  keyPhrases    Json            // string[] — for meeting bingo / tap games
  // WOL source metadata (populated when the pack was imported from a
  // wol.jw.org article). Stored as references only — body prose lives
  // at WOL, never copied here.
  issueLabel     String?         // "2026 No. 4"
  articleNumber  Int?            // 12
  themeScripture Json?           // { reference: string } — citation only, no text
  sourceUrl      String?         // canonical wol.jw.org URL
  sourceDocId    String?         // WOL doc id, for re-imports
  attribution    String?         // attribution line shown in the study UI
  // OCLM workbook metadata (populated when the pack was imported from a
  // mwb (Life & Ministry Workbook) article). Same copyright posture as
  // the Watchtower fields above — structure + citations only.
  publicationCode        String? // "mwb", "wt", …
  bibleReadingRange      Json?   // { reference: "Isaiah 65-66" }
  bibleReadingAssignment Json?   // { reference: "Isa 65:17-25" }
  songs                  Json?   // number[] — opening / middle / closing
  // sections: full workbook outline. Each section is { kind, parts: WorkbookPart[] }
  // where WorkbookPart = { number?, kind, title, durationMin?, scenarioTag?,
  // songNumber?, videoUrl?, videoTitle?, references: ReferenceImport[], promptQuestions: string[] }
  sections               Json?
  meetingWeekId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  meetingWeek MeetingWeek?   @relation(fields: [meetingWeekId], references: [id], onDelete: SetNull)
  instances   GameInstance[]
  images      ImageAsset[]
  dailyResponses DailyResponse[]

  @@index([context])
  @@index([meetingWeekId])
  @@index([source, date])
}

// GameInstance = a specific playable combination of engine + content.
model GameInstance {
  id            String      @id @default(cuid())
  gameId        String
  contentPackId String
  context       GameContext  @default(EVERGREEN)
  title         String      // e.g. "Word Search — WT April 6"
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  contentPack ContentPack @relation(fields: [contentPackId], references: [id], onDelete: Cascade)

  @@unique([gameId, contentPackId])
  @@index([context])
}

model GameSession {
  id          String        @id @default(cuid())
  userId      String
  gameId      String
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  status      SessionStatus @default(IN_PROGRESS)
  score       Int           @default(0)
  data        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameId])
}

model Score {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  value     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, value(sort: Desc)])
  @@index([userId, gameId])
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  imageUrl    String?

  profiles Profile[]
}

// ImageAsset = uploaded images for visual games (puzzles, hidden objects, coloring).
model ImageAsset {
  id            String          @id @default(cuid())
  filename      String          // original filename
  path          String          // relative path from public/ (e.g. "uploads/abc123.jpg")
  altText       String          @default("")
  categories    ImageCategory[] @default([])
  ageGroup      AgeGroup        @default(FAMILY)
  tags          Json            @default("[]") // string[]
  width         Int?
  height        Int?
  contentPackId String?
  createdAt     DateTime        @default(now())

  contentPack ContentPack? @relation(fields: [contentPackId], references: [id], onDelete: SetNull)

  @@index([contentPackId])
}

// EncyclopediaEntry = curated word/item kids can collect across games (Little Ones).
model EncyclopediaEntry {
  id          String               @id @default(cuid())
  slug        String               @unique // canonical lowercase, e.g. "ark"
  term        String               // display name, e.g. "Ark"
  definition  String               // 1–2 sentence kid-friendly definition
  imageUrl    String?              // path to image (from /public/uploads/...)
  bibleRef    String?              // optional, e.g. "Genesis 6:14"
  category    EncyclopediaCategory @default(THINGS)
  triggers    Json                 @default("[]") // string[] — alternate slugs/keywords that trigger discovery
  ageGroup    AgeGroup             @default(LITTLE_ONES)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  collections UserEncyclopediaCollection[]

  @@index([ageGroup])
  @@index([isActive])
}

// UserEncyclopediaCollection = which entries each user has collected, and where.
model UserEncyclopediaCollection {
  id          String   @id @default(cuid())
  userId      String
  entryId     String
  collectedAt DateTime  @default(now())
  viewedAt    DateTime? // first time opened in the book; null = still "New"
  source      String?   // game slug where it was discovered

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry EncyclopediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId])
}

enum EncyclopediaCategory {
  PEOPLE
  PLACES
  THINGS
  EVENTS
}

enum EncyclopediaMode {
  PLAYFUL
  STUDY
}

// PersonalEntry = a user-authored encyclopedia entry (Youth / Family / Adult).
// Lives alongside collected curated entries in the same book.
model PersonalEntry {
  id        String               @id @default(cuid())
  userId    String
  term      String
  category  EncyclopediaCategory @default(THINGS)
  bibleRef  String?
  note      String
  imageUrl  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// DailyResponse = a Youth user's written answer to a daily-text question.
// Visible to admins/parents for follow-up.
model DailyResponse {
  id            String   @id @default(cuid())
  userId        String
  contentPackId String
  questionIndex Int
  question      String   // snapshot of the question text at answer time
  response      String
  // Optional structured prep state (Watchtower study): the Youth's built or
  // multiple-choice answer, so it carries from meeting prep into Meeting Live.
  // { mode?: "build" | "mc", builtAnswer?: string }
  data          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentPack ContentPack @relation(fields: [contentPackId], references: [id], onDelete: Cascade)

  @@unique([userId, contentPackId, questionIndex])
  @@index([contentPackId])
}

enum ImageCategory {
  SCENE              // For hidden objects, backgrounds
  CHARACTER          // Bible character illustrations
  ILLUSTRATION       // General illustrations for puzzles
  OUTLINE            // Line art for coloring pages
  PHOTO              // Photos
  COLORING_SVG       // SVG files with regions for tap-to-fill (Little Ones)
  COLORING_OUTLINE   // Raster outlines for freehand drawing (Youth/Adult)
}

// ─── Enums ─────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AgeGroup {
  LITTLE_ONES
  YOUTH
  ADULT
  FAMILY
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ContentSource {
  WATCHTOWER   // Watchtower Study article
  OCLM         // Our Christian Life and Ministry workbook
  DAILY_TEXT   // Daily Text (scripture + comment)
  EVERGREEN    // General Bible content (not tied to a week)
}

enum GameContext {
  EVERGREEN       // Always available
  MEETING_PREP    // Preparation for upcoming meeting
  MEETING_LIVE    // Played during the meeting
  DAILY           // Today's Daily Text games
}
