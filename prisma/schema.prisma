generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models (NextAuth) ────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           Role      @default(USER)
  ageGroup       AgeGroup  @default(YOUTH)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  profile                 Profile?
  gameSessions            GameSession[]
  scores                  Score[]
  encyclopediaCollections UserEncyclopediaCollection[]
  personalEntries         PersonalEntry[]
  dailyResponses          DailyResponse[]
  paradisePages           ParadisePage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ────────────────────────────────────────────────

model Profile {
  id                     String           @id @default(cuid())
  userId                 String           @unique
  displayName            String
  avatarId               String           @default("default")
  xp                     Int              @default(0)
  level                  Int              @default(1)
  congregation           String?
  // Encyclopedia preferences. Mode applies to Youth/Family (Little Ones is
  // always playful, Adult always notebook). receiveCuratedFindings is the
  // Adult opt-in for admin-curated discoveries (off by default).
  encyclopediaMode       EncyclopediaMode @default(PLAYFUL)
  receiveCuratedFindings Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges Badge[]
}

// Game = a game ENGINE (e.g. "Word Search", "Trivia"). The mechanic, not the content.
model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  ageGroup    AgeGroup
  category    String
  imageUrl    String?
  // Per-audience card art. Keys: "SHARED" | "LITTLE_ONES" | "YOUTH" | "ADULT" | "FAMILY"
  // -> image path (e.g. "/uploads/abc.png"). Resolved by viewer age group with
  // fallback to SHARED. Empty object means no custom art (UI shows a placeholder).
  cardImages  Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances    GameInstance[]
  gameSessions GameSession[]
  scores       Score[]
}

// MeetingWeek groups content for a specific week's meetings.
model MeetingWeek {
  id        String   @id @default(cuid())
  weekOf    DateTime @unique // Monday of the target week
  title     String // e.g. "Week of April 6, 2026"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentPacks ContentPack[]
}

// ContentPack = extracted material from an article, daily text, or evergreen Bible topic.
model ContentPack {
  id                     String        @id @default(cuid())
  title                  String // e.g. "WT Study - April 6" or "Daily Text - March 30"
  source                 ContentSource
  context                GameContext   @default(EVERGREEN)
  sourceText             String? // citation + verbatim scripture only — never publication prose
  // Daily Text: four age-tiered summaries, written in our own words.
  // Shape: { littleOnes, youth, adult, family } where each tier is
  // { summary: string, discussionQuestion?: string } — the question is
  // populated for `family` only. Source of truth; the two String
  // columns below are legacy mirrors kept so pre-tiering rows and any
  // reader that hasn't moved over yet still render.
  commentByTier          Json?
  comment                String? // legacy mirror of commentByTier.adult.summary
  simplifiedComment      String? // legacy mirror of commentByTier.littleOnes.summary
  featuredGameSlug       String? // Daily Text: game embedded on the Little Ones Today page
  date                   DateTime? // target date (for daily text) or null
  vocabulary             Json // string[]
  scriptures             Json // { reference: string, text: string }[]
  keyPeople              Json // string[]
  themes                 Json // string[]
  questions              Json // { question, answer, simplifiedAnswer?, keyWords?, options?, imageUrl?, subheading?, references? }[]
  keyPhrases             Json // string[] — for meeting bingo / tap games
  // WOL source metadata (populated when the pack was imported from a
  // wol.jw.org article). Stored as references only — body prose lives
  // at WOL, never copied here.
  issueLabel             String? // "2026 No. 4"
  articleNumber          Int? // 12
  themeScripture         Json? // { reference: string } — citation only, no text
  sourceUrl              String? // canonical wol.jw.org URL
  sourceDocId            String? // WOL doc id, for re-imports
  attribution            String? // attribution line shown in the study UI
  // OCLM workbook metadata (populated when the pack was imported from a
  // mwb (Life & Ministry Workbook) article). Same copyright posture as
  // the Watchtower fields above — structure + citations only.
  publicationCode        String? // "mwb", "wt", …
  bibleReadingRange      Json? // { reference: "Isaiah 65-66" }
  bibleReadingAssignment Json? // { reference: "Isa 65:17-25" }
  songs                  Json? // number[] — opening / middle / closing
  // sections: full workbook outline. Each section is { kind, parts: WorkbookPart[] }
  // where WorkbookPart = { number?, kind, title, durationMin?, scenarioTag?,
  // songNumber?, videoUrl?, videoTitle?, references: ReferenceImport[], promptQuestions: string[] }
  sections               Json?
  meetingWeekId          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  meetingWeek     MeetingWeek?         @relation(fields: [meetingWeekId], references: [id], onDelete: SetNull)
  instances       GameInstance[]
  images          ImageAsset[]
  dailyResponses  DailyResponse[]
  vocabularyLinks PackVocabularyLink[]
  firstSeenTerms  VocabularyTerm[]     @relation("VocabularyFirstSeenPack")

  @@index([context])
  @@index([meetingWeekId])
  @@index([source, date])
}

// GameInstance = a specific playable combination of engine + content.
model GameInstance {
  id            String      @id @default(cuid())
  gameId        String
  contentPackId String
  context       GameContext @default(EVERGREEN)
  title         String // e.g. "Word Search — WT April 6"
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  contentPack ContentPack @relation(fields: [contentPackId], references: [id], onDelete: Cascade)

  @@unique([gameId, contentPackId])
  @@index([context])
}

model GameSession {
  id        String        @id @default(cuid())
  userId    String
  gameId    String
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  status    SessionStatus @default(IN_PROGRESS)
  score     Int           @default(0)
  data      Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, gameId])
}

model Score {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  value     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, value(sort: Desc)])
  @@index([userId, gameId])
}

model Badge {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  imageUrl    String?

  profiles Profile[]
}

// ImageAsset = uploaded images for visual games (puzzles, hidden objects, coloring).
model ImageAsset {
  id            String          @id @default(cuid())
  filename      String // original filename
  path          String // relative path from public/ (e.g. "uploads/abc123.jpg")
  altText       String          @default("")
  categories    ImageCategory[] @default([])
  ageGroup      AgeGroup        @default(FAMILY)
  tags          Json            @default("[]") // string[]
  width         Int?
  height        Int?
  contentPackId String?
  createdAt     DateTime        @default(now())

  contentPack ContentPack? @relation(fields: [contentPackId], references: [id], onDelete: SetNull)

  @@index([contentPackId])
}

// EncyclopediaEntry = curated word/item kids can collect across games (Little Ones).
model EncyclopediaEntry {
  id         String               @id @default(cuid())
  slug       String               @unique // canonical lowercase, e.g. "ark"
  term       String // display name, e.g. "Ark"
  definition String // 1–2 sentence kid-friendly definition — fallback when contentByTier is null
  imageUrl   String? // path to image (from /public/uploads/...); used when no linked sticker
  bibleRef   String? // optional, e.g. "Genesis 6:14"
  category   EncyclopediaCategory @default(THINGS)
  triggers   Json                 @default("[]") // string[] — alternate slugs/keywords that trigger discovery
  ageGroup   AgeGroup             @default(LITTLE_ONES) // informational label; NOT a gate — every entry is available to every viewer, content adapts to age via `contentByTier`
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // ── Richer per-entry fields (all optional) ────────────────────────
  // Populated by the Bible-character extraction pipeline; plain entries
  // (uploaded via the older admin flow) leave these null and the app
  // falls back to `definition`.

  /// Era tag for people/events (e.g. "Patriarchs", "Kings", "Gospels").
  era           String?
  /// Ordered timeline for people/events: [{ when, event }, ...].
  timeline      Json?
  /// Place names associated with a person/event.
  locations     String[] @default([])
  /// Three-tier language content — same shape per tier: shortDescription,
  /// longBlurb, trivia?, cluesHardToEasy?. Games and pages pick the tier
  /// matching the viewer's ageGroup; FAMILY viewers default to youth.
  contentByTier Json?

  /// Optional 1:1 link to a Sticker. When present, the sticker acts as
  /// the entry's portrait AND the collectable art unlocked when the
  /// user discovers this entry. Only BIBLE_CHARACTER-kind stickers are
  /// currently linked this way, but the FK is generic.
  stickerId String?  @unique
  sticker   Sticker? @relation("EncyclopediaSticker", fields: [stickerId], references: [id], onDelete: SetNull)

  collections UserEncyclopediaCollection[]

  @@index([ageGroup])
  @@index([isActive])
  @@index([category])
}

// UserEncyclopediaCollection = which entries each user has collected, and where.
model UserEncyclopediaCollection {
  id          String    @id @default(cuid())
  userId      String
  entryId     String
  collectedAt DateTime  @default(now())
  viewedAt    DateTime? // first time opened in the book; null = still "New"
  source      String? // game slug where it was discovered

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry EncyclopediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@index([userId])
}

enum EncyclopediaCategory {
  PEOPLE
  PLACES
  THINGS
  EVENTS
}

enum EncyclopediaMode {
  PLAYFUL
  STUDY
}

// PersonalEntry = a user-authored encyclopedia entry (Youth / Family / Adult).
// Lives alongside collected curated entries in the same book.
model PersonalEntry {
  id        String               @id @default(cuid())
  userId    String
  term      String
  category  EncyclopediaCategory @default(THINGS)
  bibleRef  String?
  note      String
  imageUrl  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// DailyResponse = a Youth user's written answer to a daily-text question.
// Visible to admins/parents for follow-up.
model DailyResponse {
  id            String   @id @default(cuid())
  userId        String
  contentPackId String
  questionIndex Int
  question      String // snapshot of the question text at answer time
  response      String
  // Optional structured prep state (Watchtower study): the Youth's built or
  // multiple-choice answer, so it carries from meeting prep into Meeting Live.
  // { mode?: "build" | "mc", builtAnswer?: string }
  data          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentPack ContentPack @relation(fields: [contentPackId], references: [id], onDelete: Cascade)

  @@unique([userId, contentPackId, questionIndex])
  @@index([contentPackId])
}

enum ImageCategory {
  SCENE // For hidden objects, backgrounds
  CHARACTER // Bible character illustrations
  ILLUSTRATION // General illustrations for puzzles
  OUTLINE // Line art for coloring pages
  PHOTO // Photos
  COLORING_SVG // SVG files with regions for tap-to-fill (Little Ones)
  COLORING_OUTLINE // Raster outlines for freehand drawing (Youth/Adult)
}

// ─── Vocabulary Catalog ────────────────────────────────────────────────
//
// The vocabulary catalog is a taxonomic, cross-pack dictionary of words
// and phrases the app has seen. Instead of games pulling from `pack.vocabulary`
// silos, they query the catalog with filters (category, age, useCount) so
// coverage is diverse and every new pack contributes to a growing library.
//
// Terms are canonicalised on the `term` field (lowercased + trimmed) and
// unique globally. `display` preserves the original casing (proper names).
// A term can belong to multiple categories via VocabularyTermCategory; the
// (termId, categoryId) pair is unique — same category can't hold duplicates.

model VocabularyCategory {
  id          String   @id @default(cuid())
  slug        String   @unique // "prayer", "bible-characters", etc.
  name        String // "Prayer"
  description String?
  icon        String? // optional emoji or short glyph shown in badges
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  terms VocabularyTermCategory[]

  @@index([isActive])
}

model VocabularyTerm {
  id              String             @id @default(cuid())
  term            String             @unique // canonical: lowercased + trimmed
  display         String // original casing, for UI
  type            VocabularyTermType
  ageAppropriate  String[]           @default([]) // subset of AgeGroup — empty means "all ages"
  bibleRef        String? // optional citation, e.g. "Prov. 3:5"
  useCount        Int                @default(0)
  firstSeenPackId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  categories    VocabularyTermCategory[]
  packLinks     PackVocabularyLink[]
  firstSeenPack ContentPack?             @relation("VocabularyFirstSeenPack", fields: [firstSeenPackId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([useCount])
}

// Join: many terms ↔ many categories. Compound PK enforces "no duplicates
// within the same category" while still allowing a term to appear under
// multiple categories.
model VocabularyTermCategory {
  termId     String
  categoryId String
  createdAt  DateTime @default(now())

  term     VocabularyTerm     @relation(fields: [termId], references: [id], onDelete: Cascade)
  category VocabularyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([termId, categoryId])
  @@index([categoryId])
}

// Join: many packs ↔ many terms. Tracks provenance so we know which
// packs a term appears in and can weight game selection toward the
// current week's material.
model PackVocabularyLink {
  packId    String
  termId    String
  createdAt DateTime @default(now())

  pack ContentPack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  term VocabularyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([packId, termId])
  @@index([termId])
}

enum VocabularyTermType {
  WORD // single word (no spaces)
  PHRASE // multi-word phrase
}

// ─── Enums ─────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AgeGroup {
  LITTLE_ONES
  YOUTH
  ADULT
  FAMILY
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ContentSource {
  WATCHTOWER // Watchtower Study article
  OCLM // Our Christian Life and Ministry workbook
  DAILY_TEXT // Daily Text (scripture + comment)
  EVERGREEN // General Bible content (not tied to a week)
}

enum GameContext {
  EVERGREEN // Always available
  MEETING_PREP // Preparation for upcoming meeting
  MEETING_LIVE // Played during the meeting
  DAILY // Today's Daily Text games
}

// ─── Paradise Builder assets ───────────────────────────────────────────
//
// Characters, Stickers, and Scenes back the Paradise Builder game and
// (later) any other place the app wants to reuse a named person or a
// gentle landscape backdrop. Design notes:
//
// - Character is the durable identity ("Emma Miller"). The Sticker is
//   one PNG of that character in one pose. A Character has 0-or-1
//   Sticker today; later it can grow additional art (story panels,
//   card faces) without changing the Character row.
// - Non-people stickers (Isaiah pairs, animals, plants, homes, sky)
//   have no Character — the Sticker row is the whole entity.
// - Scenes are opaque background "book pages" — completely
//   independent of Sticker; joined at composition time by the game.
// - All image paths follow the ImageAsset convention: relative to
//   /public, NO leading slash (e.g. "uploads/stickers/xxx.png"). The
//   UI prefixes the slash at render time.

model Character {
  id             String   @id @default(cuid())
  slug           String   @unique // "emma-miller"
  name           String // "Emma Miller"
  familyName     String? // "Miller" — null for non-family characters (future Bible-times figures)
  role           String // "grandmother" | "grandfather" | "mother" | "father" | "teen-girl" | "teen-boy" | "child-girl" | "child-boy"
  variant        String // "blonde" | "brunette" | "black" | "hispanic" | "asian"
  identityPrompt String // frozen identity string from characters.md — pasted verbatim into future AI generations
  portraitPath   String? // canonical portrait: relative to /public, no leading slash
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sticker Sticker?

  @@index([variant, role]) // for the upload UI's auto-match from filename
  @@index([familyName])
}

model Sticker {
  id             String      @id @default(cuid())
  slug           String      @unique // "emma-miller", "lion-lamb", "dove"
  name           String // display name shown in the tray: "Emma", "Lion & Lamb", "Dove"
  kind           StickerKind
  path           String // relative to /public, no leading slash
  tags           String[]    @default([]) // free-form: "isaiah-11", "prayer", "harvest"
  ageAppropriate String[]    @default([]) // subset of AgeGroup values; empty means "all ages"
  altText        String      @default("") // screen-reader description
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)

  characterId String?    @unique
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  /// Reverse side of the EncyclopediaEntry.sticker 1:1 relation. When
  /// present, this sticker is the collectable art for that entry.
  encyclopediaEntry EncyclopediaEntry? @relation("EncyclopediaSticker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([isActive])
}

enum StickerKind {
  PERSON // modern family persona linked to a Character row
  BIBLE_CHARACTER // historical figure — Moses, Ruth, David, ... Later linked to a BibleCharacter row.
  ANIMAL_PAIR // Isaiah 11 pairs (lion + lamb, wolf + kid, ...)
  ANIMAL_SOLO // dove, giraffe, rabbit, ...
  PLANT // fruit tree, wildflowers, grape vine, ...
  HOME // cottage, well, garden gate, bench, ...
  SKY // rainbow, sun, cloud, waterfall
}

model Scene {
  id            String   @id @default(cuid())
  slug          String   @unique // "meadow", "lakeside", "starry-night-meadow"
  name          String // "Sunny Meadow", "Lakeside", "Starry Night"
  path          String // relative to /public, no leading slash
  moodTags      String[] @default([]) // "day" | "morning" | "night" | "water" | "forest" | ...
  paletteAccent String? // dominant color from prompt: "sky" | "violet" | ...
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paradisePages ParadisePage[]

  @@index([isActive])
}

// A user's saved paradise page. Backs the Paradise Builder game — one
// scene per page, any number of sticker placements. Multiple pages per
// user (a garden AND a lakeside scene, kept separately). `placements`
// is a JSON array of Placement objects (see the paradise-builder
// component); it isn't a foreign key relation because a single sticker
// can appear many times on one page (stacking / overlapping is normal),
// which the relational shape can't express cheaply.
model ParadisePage {
  id         String   @id @default(cuid())
  userId     String
  sceneId    String
  name       String   @default("My Paradise")
  placements Json     @default("[]") // [{id, stickerSlug, x, y, scale, zOrder}, ...]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sceneId])
}
