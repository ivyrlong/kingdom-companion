# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# User-uploaded stickers / cards / game images.
# Files already tracked stay tracked (they seed a fresh env); new
# admin uploads on a dev machine are ignored — production uploads
# live in the bind-mounted /opt/kingdom-companion/data/uploads/
# volume, never in the repo.
/public/uploads/*
!/public/uploads/.gitkeep
# If you deliberately want to add a new baked-in image, use
# `git add -f public/uploads/xxx.png`.
